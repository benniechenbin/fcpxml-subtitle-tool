{
  "name": "fcpxml-subtitle-tool",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint main.js --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "main.js": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{html,css,json,md,mjs,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6"
  }
}
